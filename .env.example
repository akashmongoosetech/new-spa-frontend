# Frontend API base URL.
# Uses the Vite dev proxy when set to /api (default). Set a full URL when the
# backend is hosted separately (e.g. VITE_API_URL=https://api.example.com/api).
VITE_API_URL=/api

# Vite dev proxy target (only used when VITE_API_URL=/api)
VITE_API_PROXY_TARGET=http://localhost:3000

# Application name used in the UI
VITE_APP_NAME=Aura Luxe
