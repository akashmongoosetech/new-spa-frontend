# Frontend API base URL.
# Uses the Vite dev proxy when set to /api (default). Set a full URL when the
# backend is hosted separately (e.g. VITE_API_URL=https://api.example.com/api).
VITE_API_URL=/api

# Vite dev proxy target (only used when VITE_API_URL=/api)
VITE_API_PROXY_TARGET=http://localhost:3000

# Application name used in the UI
VITE_APP_NAME=Tripod Wellness

# Canonical public site URL used by static metadata and edge functions.
# Set this to the production HTTPS origin (no trailing slash).
VITE_SITE_URL=https://tripod-wellness.netlify.app

# Optional X/Twitter handle for twitter:site metadata (for example @tripodwellness)
VITE_TWITTER_HANDLE=

# Optional Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
# Leave empty to disable analytics and the consent banner entirely.
VITE_GA_MEASUREMENT_ID=
